{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studybase-admin",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_ORIGIN": ""
  }
}
